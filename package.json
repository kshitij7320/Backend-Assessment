{
  "name": "shodh-a-code-backend",
  "version": "1.0.0",
  "description": "Shodh a Code — Contest Platform Backend (NestJS + PostgreSQL + Isolated Docker Judge)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:worker": "node dist/worker-main.js",
    "start:worker:dev": "tsx src/worker-main.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "verify": "tsx scripts/verify-all.ts",
    "benchmark": "tsx scripts/workload-benchmark.ts",
    "bottleneck": "tsx scripts/investigate-bottleneck.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
